{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "1. Compile cpp to object file",
            "type": "shell",
            "command": "g++",
            "args": [
                "-c",
                "${workspaceFolder}/src/cppNetworkUtil.cpp",
                "-o",
                "${workspaceFolder}/lib/cppNetworkUtil.o",
                "-I",
                "${workspaceFolder}/openssl/include",
                "-I",
                "${workspaceFolder}/include"
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "2. Create static library (archive)",
            "type": "shell",
            "command": "ar",
            "args": [
                "rcs",
                "${workspaceFolder}/lib/cppNetworkUtil.a",
                "${workspaceFolder}/lib/cppNetworkUtil.o",
                "${workspaceFolder}/openssl/lib/libcrypto.a",
                "${workspaceFolder}/openssl/lib/libssl.a"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "dependsOn": [
                "1. Compile cpp to object file"
            ],
            "problemMatcher": []
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe 生成活动文件",
            "command": "C:\\Program Files\\RedPanda-Cpp\\mingw64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "调试器生成的任务。"
        }
    ]
}