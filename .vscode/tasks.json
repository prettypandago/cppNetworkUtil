{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe 生成活动文件",
            "command": "g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "*.cpp",
                "-o",
                "${fileDirname}/cppNetworkUtil.exe",
                "-I",
                "\"C:/Program Files/OpenSSL-Win64/include\"",
                "-L",
                "\"C:/Program Files/OpenSSL-Win64/lib\"",
                "-lssl",
                "-lcrypto",
                "-lws2_32",
                "-lcrypt32",
                "-static-libgcc",
                "-static-libstdc++"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "调试器生成的任务。"
        }
    ],
    "version": "2.0.0"
}